# Public URL of this hub, e.g. https://admin-hub-yourname.vercel.app (no trailing slash)
HUB_URL=

# The hub's OWN Postgres database (hub accounts, projects, teams). Not a product database.
# Any empty Postgres works, e.g. Neon from Vercel's Storage tab.
HUB_DATABASE_URL=

# Random secrets. Generate each with: openssl rand -base64 32
HUB_SECRET=
# Encrypts saved product database URLs. Changing it means re-entering them in each project's Settings.
HUB_ENCRYPTION_KEY=

# Google OAuth client (Web application).
# Authorized redirect URI: <HUB_URL>/api/auth/callback/google
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=

# Comma-separated emails that can sign in without an invitation and create projects.
HUB_OWNER_EMAILS=

# Optional extra gate: HTTP Basic Auth in front of everything. Leave empty to turn it off.
HUB_BASIC_USER=
HUB_BASIC_PASSWORD=
