# Public URL of this hub, e.g. https://admin-hub-yourname.vercel.app
HUB_URL=

# Outer gate (HTTP Basic Auth) for the whole hub. Use a long random password.
HUB_BASIC_USER=
HUB_BASIC_PASSWORD=

# --- OnRecord ---
# Postgres URL of OnRecord's database (the same DB the web app's DATABASE_URL points at).
ONRECORD_DATABASE_URL=
# Random 32+ char secret for studio sessions. Generate: openssl rand -base64 32
# Rotating it signs everyone out of the OnRecord studio immediately.
ONRECORD_STUDIO_SECRET=
# Comma-separated emails allowed in. Each must also have role "admin" in auth_user.
ONRECORD_ADMIN_EMAILS=
