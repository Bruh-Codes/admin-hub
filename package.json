{
  "name": "auth-hub",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run studio-ui && next build",
    "vercel-build": "npm run studio-ui && tsx scripts/migrate.mts && next build",
    "db:migrate": "tsx scripts/migrate.mts",
    "start": "next start",
    "studio-ui": "npm --prefix studio-ui ci --legacy-peer-deps --no-audit --no-fund && npm --prefix studio-ui run build:hub && node scripts/use-studio-ui.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "better-auth": "1.7.3",
    "better-auth-studio": "1.1.5",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
